spawn-at-startup "fnott"
spawn-at-startup "pipewire"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "wbg" "-s" "Pictures/Wallpapers/ariana.jpeg"

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/ Screenshot from %Y-%m-%d %H-%M-%S.png"

environment {
  DISPLAY ":0"
  SHELL "/bin/fish"
}

cursor {
  xcursor-theme "Adwaita"
  xcursor-size 20
  hide-after-inactive-ms 10000
}

overview {
  zoom 0.6
  backdrop-color "#040405"
  workspace-shadow {
    off
  }
}

xwayland-satellite {
  off
}
